# =============================================================================
# Environment variables for shawncapizzi.com
#
# Copy this file to `.env.local` for local development.
# For production, set these in Vercel project settings → Environment Variables.
# =============================================================================

# Cookiebot Domain Group ID (CBID) — UUID format
NEXT_PUBLIC_COOKIEBOT_CBID=8624953a-eb4e-4803-87f7-1d4b310b47b2

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-5H7TJK5WB8

# Sign-up list (Google Sheet + Apps Script web app). See docs/google-signup/Code.gs.
# Set both in Vercel. SIGNUP_SECRET must match SECRET in the script.
SIGNUP_WEBHOOK_URL=
SIGNUP_SECRET=
